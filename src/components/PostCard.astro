---
import type { CollectionEntry } from 'astro:content';
import { withBase, fmtDate } from '../lib/url';
import { postHref } from '../lib/hotspots';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, category } = post.data;
---

<article class="post-card">
  <div class="row">
    <h2>
      <a href={withBase(postHref(post.id))}>{title}</a>
    </h2>
    <span class="chip">{category}</span>
  </div>
  <p class="desc">{description}</p>
  <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
</article>

<style>
  .post-card {
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line-soft);
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.5;
  }

  h2 a {
    color: var(--ink);
  }

  h2 a:hover {
    color: var(--brass);
    text-decoration: none;
  }

  .chip {
    flex-shrink: 0;
    font-size: var(--text-xs);
    color: var(--brass);
    border: 1px solid var(--brass);
    border-radius: 999px;
    padding: 0.1em 0.8em;
    opacity: 0.8;
  }

  .desc {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  time {
    display: block;
    margin-top: var(--space-2);
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }
</style>
