---
import { SITE, NAV } from '../config/site';
import { withBase } from '../lib/url';

const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(withBase(href));
---

<header class="site-header focus-dim">
  <div class="container inner">
    <a class="brand" href={withBase('/')} title="回到书桌">
      <span class="brand-mark" aria-hidden="true">☕</span>
      {SITE.title}
    </a>
    <nav aria-label="站点导航">
      {
        NAV.map((item) => (
          <a
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <button
      id="theme-toggle"
      type="button"
      aria-label="切换昼夜模式"
      title="切换昼夜模式"
    >
      <span class="icon-sun" aria-hidden="true">☀</span>
      <span class="icon-moon" aria-hidden="true">☾</span>
    </button>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    window.deskTheme?.toggle();
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--line-soft);
    background: var(--paper);
    transition: background-color var(--dur-slow) var(--ease-out);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-4);
  }

  .brand {
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .brand:hover {
    color: var(--brass);
    text-decoration: none;
  }

  .brand-mark {
    color: var(--brass);
  }

  nav {
    display: flex;
    gap: var(--space-4);
    margin-left: auto;
    flex-wrap: wrap;
  }

  nav a {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  nav a:hover {
    color: var(--brass);
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: var(--brass);
    font-weight: 500;
  }

  #theme-toggle {
    color: var(--brass);
    font-size: var(--text-lg);
    line-height: 1;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
  }

  #theme-toggle:hover {
    background: var(--paper-sunken);
  }

  .icon-moon {
    display: none;
  }

  :global([data-theme='night']) .icon-sun {
    display: none;
  }

  :global([data-theme='night']) .icon-moon {
    display: inline;
  }

  @media (max-width: 640px) {
    .inner {
      gap: var(--space-3);
    }

    nav {
      gap: var(--space-3);
    }
  }
</style>
