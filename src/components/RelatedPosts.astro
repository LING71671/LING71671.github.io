---
import type { CollectionEntry } from 'astro:content';
import { withBase, fmtDate } from '../lib/url';
import { postHref } from '../lib/hotspots';

interface Props {
  posts: CollectionEntry<'posts'>[];
  next?: CollectionEntry<'posts'> | undefined;
}

const { posts, next } = Astro.props;
---

{
  (posts.length > 0 || next) && (
    <aside class="related" aria-label="相关文章">
      {posts.length > 0 && (
        <>
          <h2>相关文章</h2>
          <ul>
            {posts.map((p) => (
              <li>
                <a href={withBase(postHref(p.id))}>{p.data.title}</a>
                <time datetime={p.data.pubDate.toISOString()}>
                  {fmtDate(p.data.pubDate)}
                </time>
              </li>
            ))}
          </ul>
        </>
      )}
      {next && (
        <a class="next card" href={withBase(postHref(next.id))}>
          <span class="hint">继续阅读下一篇</span>
          <span class="title">{next.data.title}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      )}
    </aside>
  )
}

<style>
  .related h2 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--ink-soft);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line-soft);
  }

  .related ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-3);
  }

  .related li a {
    display: block;
    color: var(--ink);
    line-height: 1.6;
  }

  .related li a:hover {
    color: var(--brass);
    text-decoration: none;
  }

  .related li time {
    color: var(--ink-faint);
    font-size: var(--text-xs);
  }

  .next {
    margin-top: var(--space-5);
    display: block;
    padding: var(--space-4);
    color: var(--ink);
    position: relative;
  }

  .next:hover {
    text-decoration: none;
    border-color: var(--brass);
  }

  .next .hint {
    display: block;
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .next .title {
    display: block;
    margin-top: var(--space-1);
    font-weight: 700;
    padding-right: 1.5em;
  }

  .next .arrow {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    color: var(--brass);
  }
</style>
