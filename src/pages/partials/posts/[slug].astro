---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticleBody from '../../../components/ArticleBody.astro';
import PanelMeta from '../../../components/PanelMeta.astro';
import { publishedPosts } from '../../../lib/archive';

export const partial = true;

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection('posts'));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const allPosts = publishedPosts(await getCollection('posts'));
---

<PanelMeta title={post.data.title} url={`/posts/${post.id}/`} />
<ArticleBody post={post} allPosts={allPosts} />
