---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE, NAV } from '../config/site';
import { withBase } from '../lib/url';
import { publishedPosts } from '../lib/archive';
import { postHref } from '../lib/hotspots';
import { fmtDate } from '../lib/url';
import { SCENE_TIME_ANCHORS } from '../lib/scene-time-anchors';

/*
 * 以下导入不直接渲染 —— 仅为把 partial 用到的组件样式带进首页 CSS 图，
 * 保证覆盖面板注入的片段（携带相同 scoped class）有样式可用。
 */
import '../components/ArticleBody.astro';
import '../components/views/PostListView.astro';
import '../components/views/ProjectsView.astro';
import '../components/views/ArchiveView.astro';
import '../components/views/AboutView.astro';
import '../components/views/StatusView.astro';
import '../components/views/StickyNotesView.astro';

const latest = publishedPosts(await getCollection('posts')).slice(0, 3);
const loaderTimeAnchors = JSON.stringify(SCENE_TIME_ANCHORS);
---

<BaseLayout description={SITE.description} preloadDesk>
  {/* WebGL 能力检测：先于首绘，成功则隐藏语义首页、显示 3D（自动降级，无用户开关） */}
  <script is:inline slot="head">
    (function () {
      try {
        var c = document.createElement('canvas');
        var gl = c.getContext('webgl2') || c.getContext('webgl');
        if (gl) document.documentElement.classList.add('webgl');
      } catch (e) {
        /* 保持降级 */
      }
    })();
  </script>

  {/* —— 语义首页：爬虫 / 无 JS / 无 WebGL 的入口 —— */}
  <main id="fallback-home" class="container-narrow">
    <header class="fb-head">
      <h1>{SITE.title}</h1>
      <p class="lede">{SITE.description}</p>
      <noscript><p class="note">完整的 3D 书桌体验需要 JavaScript，以下为站点导航。</p></noscript>
    </header>
    <nav class="fb-nav" aria-label="站点导航">
      {NAV.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </nav>
    <section class="fb-latest">
      <h2>最近的笔记</h2>
      <ul>
        {
          latest.map((post) => (
            <li>
              <a href={withBase(postHref(post.id))}>{post.data.title}</a>
              <time datetime={post.data.pubDate.toISOString()}>
                {fmtDate(post.data.pubDate)}
              </time>
            </li>
          ))
        }
      </ul>
    </section>
    <footer class="fb-foot">
      <p class="hand">{SITE.motto}</p>
    </footer>
  </main>

  {/* —— 3D 书桌 —— */}
  <div id="desk-root" aria-busy="true">
    <div
      id="scene-loader"
      role="status"
      aria-live="polite"
      data-loader-base={withBase('/images/loader')}
      data-allow-time-override={import.meta.env.DEV ? 'true' : 'false'}
      data-time-anchors={loaderTimeAnchors}
    >
      <div class="scene-loader__drift" aria-hidden="true">
        <div class="scene-loader__poster scene-loader__poster--from"></div>
        <div class="scene-loader__poster scene-loader__poster--to"></div>
      </div>
      <div class="scene-loader__atmosphere" aria-hidden="true"></div>
      <div class="scene-loader__grain" aria-hidden="true"></div>
      <span class="visually-hidden">正在准备书桌场景</span>
    </div>
    <script is:inline>
      (function () {
        var loader = document.getElementById('scene-loader');
        if (!loader) return;

        var now = new Date();
        var allowCaptureOverrides = loader.dataset.allowTimeOverride === 'true';
        var debugParams = allowCaptureOverrides ? new URLSearchParams(location.search) : null;
        if (debugParams) {
          var debugTime = debugParams.get('time');
          var match = debugTime && debugTime.match(/^([01]\d|2[0-3]):([0-5]\d)$/);
          if (match) now.setHours(Number(match[1]), Number(match[2]), 0, 0);
        }
        var capturePose = debugParams && debugParams.get('poster');
        if (capturePose !== 'entry' && capturePose !== 'home') capturePose = null;
        if (capturePose) document.documentElement.classList.add('poster-capture');

        var minute = now.getHours() * 60 + now.getMinutes();
        var smooth = function (value) {
          var t = Math.max(0, Math.min(1, value));
          return t * t * (3 - 2 * t);
        };
        var anchors = JSON.parse(loader.dataset.timeAnchors || '[]');
        var fromAnchor = anchors[0] || { minute: 0, moment: 'night' };
        var toAnchor = anchors[1] || { minute: 1440, moment: 'night' };
        for (var i = 0; i < anchors.length - 1; i += 1) {
          if (minute >= anchors[i].minute && minute < anchors[i + 1].minute) {
            fromAnchor = anchors[i];
            toAnchor = anchors[i + 1];
            break;
          }
        }
        var from = fromAnchor.moment;
        var to = toAnchor.moment;
        var mix = smooth(
          (minute - fromAnchor.minute) /
            Math.max(1, toAnchor.minute - fromAnchor.minute),
        );

        var navigation = performance.getEntriesByType('navigation')[0];
        var replayEntry = navigation && navigation.type === 'reload';
        var completed = false;
        try {
          completed = !replayEntry && sessionStorage.getItem('desk.session.clockDone') === '1';
        } catch (e) {
          /* 隐私模式下按首次入口处理 */
        }
        var pose = capturePose || (completed ? 'home' : 'entry');
        var base = loader.dataset.loaderBase || '/images/loader';
        var preloaded = {};
        var orientation = matchMedia('(orientation: portrait)');
        var preload = function (url, priority) {
          if (preloaded[url]) return;
          preloaded[url] = true;
          var link = document.createElement('link');
          link.rel = 'preload';
          link.as = 'image';
          link.href = url;
          link.setAttribute('fetchpriority', priority);
          document.head.appendChild(link);
        };
        loader.dataset.pose = pose;

        var applyLayout = function () {
          var suffix = orientation.matches ? '-portrait' : '';
          var source = function (moment) {
            return base + '/' + pose + '-' + moment + suffix + '.webp';
          };
          var visibleFrom = from;
          var visibleTo = to;
          var visibleMix = mix;
          // 临近锚点时只取一张，避免 opacity:0 的背景仍触发无效下载。
          if (visibleMix <= 0.02) {
            visibleTo = visibleFrom;
            visibleMix = 0;
          } else if (visibleMix >= 0.98) {
            visibleFrom = visibleTo;
            visibleMix = 0;
          }
          loader.dataset.moment =
            visibleFrom === visibleTo ? visibleFrom : visibleFrom + '-' + visibleTo;
          var fromUrl = source(visibleFrom);
          var toUrl = source(visibleTo);
          loader.style.setProperty('--loader-from-image', 'url("' + fromUrl + '")');
          loader.style.setProperty('--loader-to-image', 'url("' + toUrl + '")');
          loader.style.setProperty('--loader-mix', String(visibleMix));
          preload(fromUrl, 'high');
          if (toUrl !== fromUrl) preload(toUrl, visibleMix >= 0.25 ? 'high' : 'low');
        };
        var onOrientation = function () {
          applyLayout();
        };
        applyLayout();
        if (orientation.addEventListener) orientation.addEventListener('change', onOrientation);
        else if (orientation.addListener) orientation.addListener(onOrientation);
        loader.addEventListener('loader:dispose', function () {
          if (orientation.removeEventListener) orientation.removeEventListener('change', onOrientation);
          else if (orientation.removeListener) orientation.removeListener(onOrientation);
        }, { once: true });
      })();
    </script>
    <canvas id="desk-canvas"></canvas>
    {/* CSS3D 屏幕系统层（ScreenOS 把 DOM 桌面贴进 3D 显示器；未聚焦时不拦截指针） */}
    <div id="screen-os-layer" aria-hidden="true"></div>
    <div id="vignette" aria-hidden="true"></div>

    <div id="hud" aria-hidden="true">
      <div id="hotspot-tip"></div>
      <div id="toast" hidden></div>
      <div id="entry-ui">
        <p id="entry-caption" class="hand">
          房间的时间停住了。<br />请将时钟调到 <strong>7:20</strong>。
        </p>
        <p id="entry-feedback" class="hand" hidden></p>
      </div>
    </div>

    <button id="mute-btn" type="button" aria-label="环境音开关" aria-pressed="false" disabled>♪</button>

    <div id="overlay-backdrop" hidden></div>
    <section
      id="panel"
      role="dialog"
      aria-modal="true"
      aria-label="内容面板"
      tabindex="-1"
      hidden
    >
      <header>
        <span id="panel-title"></span>
        <button id="panel-close" type="button" aria-label="关闭（ESC）">✕</button>
      </header>
      <div id="panel-scroll"></div>
    </section>
  </div>

  <script>
    import '../scripts/desk/boot';
    import '../scripts/behaviors';
  </script>
</BaseLayout>

<style is:global>
  html.webgl body {
    overflow: hidden;
    height: 100dvh;
  }

  html.webgl #fallback-home {
    display: none;
  }

  html:not(.webgl) #desk-root {
    display: none;
  }

  /* hidden 属性必须赢过组件自身的 display 声明 */
  #panel[hidden],
  #overlay-backdrop[hidden],
  #toast[hidden] {
    display: none !important;
  }

  /* 仅开发环境 ?poster=entry|home 捕获源帧：不把 HUD / 音频按钮烘进海报。 */
  html.poster-capture #hud,
  html.poster-capture #mute-btn {
    display: none !important;
  }

  /* 覆盖面板骨架屏（innerHTML 注入，需全局选择器） */
  .panel-skeleton {
    padding: var(--space-6) 0;
    display: grid;
    gap: var(--space-4);
  }

  .panel-skeleton .sk {
    height: 1em;
    border-radius: var(--radius-sm);
    background: var(--paper-sunken);
    animation: sk-pulse 1.2s ease-in-out infinite;
  }

  .panel-skeleton .sk-title {
    height: 2em;
    width: 60%;
  }

  .panel-skeleton .sk-short {
    width: 40%;
  }

  @keyframes sk-pulse {
    50% {
      opacity: 0.55;
    }
  }
</style>

<style>
  /* —— 语义首页 —— */
  #fallback-home {
    padding-block: var(--space-8);
  }

  .fb-head h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
  }

  .fb-head .lede {
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  .note {
    margin-top: var(--space-3);
    color: var(--brass);
    font-size: var(--text-sm);
  }

  .fb-nav {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .fb-nav a {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35em 1.4em;
    color: var(--ink-soft);
  }

  .fb-nav a:hover {
    color: var(--brass);
    border-color: var(--brass);
    text-decoration: none;
  }

  .fb-latest {
    margin-top: var(--space-7);
  }

  .fb-latest h2 {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--ink-soft);
  }

  .fb-latest ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  .fb-latest time {
    display: block;
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  .fb-foot {
    margin-top: var(--space-8);
    color: var(--ink-faint);
  }

  /* —— 3D 场景层 —— */
  #desk-root {
    position: fixed;
    inset: 0;
    background: #0e0a06;
  }

  /*
   * 加载层不是独立 UI，而是最终镜头的低带宽时间切片。
   * WebGL 首帧到位后，从动画的当前矩阵收束到精确机位再交叉淡化。
   */
  #scene-loader {
    position: absolute;
    inset: 0;
    z-index: 15;
    overflow: hidden;
    contain: strict;
    background: #0b0b0c;
    opacity: 1;
    visibility: visible;
    transition:
      opacity 1.15s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 1.15s;
  }

  #desk-root.scene-ready #scene-loader {
    opacity: 0;
    visibility: hidden;
  }

  .scene-loader__drift,
  .scene-loader__poster,
  .scene-loader__atmosphere,
  .scene-loader__grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .scene-loader__drift {
    inset: 0;
    transform-origin: 50% 50%;
    will-change: transform;
    animation: scene-loader-drift 15s cubic-bezier(0.45, 0.05, 0.2, 1) infinite alternate;
    transition: transform 1.15s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .scene-loader__poster {
    inset: 0;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    filter: blur(3px) brightness(0.82) saturate(0.92);
    will-change: opacity, filter;
    transition: filter 1.15s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .scene-loader__poster--from {
    background-image: var(--loader-from-image);
  }

  .scene-loader__poster--to {
    background-image: var(--loader-to-image);
    opacity: var(--loader-mix, 0);
  }

  .scene-loader__atmosphere {
    inset: -12%;
    background:
      radial-gradient(ellipse at 28% 72%, rgb(218 151 78 / 0.16), transparent 36%),
      linear-gradient(108deg, rgb(6 10 18 / 0.18), transparent 45%, rgb(231 183 113 / 0.08));
    mix-blend-mode: soft-light;
    opacity: 0.7;
    will-change: transform, opacity;
    animation: scene-loader-light 8s ease-in-out infinite alternate;
  }

  .scene-loader__grain {
    opacity: 0.075;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.52'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  #scene-loader.is-revealing .scene-loader__poster {
    filter: blur(0) brightness(1) saturate(1);
  }

  @keyframes scene-loader-drift {
    0% {
      transform: translate3d(-0.55%, 0.35%, 0) scale(1.035);
    }
    48% {
      transform: translate3d(0.15%, -0.18%, 0) scale(1.047);
    }
    100% {
      transform: translate3d(0.7%, -0.52%, 0) scale(1.055);
    }
  }

  @keyframes scene-loader-light {
    from {
      opacity: 0.48;
      transform: translate3d(-2.5%, 1%, 0) rotate(-0.5deg);
    }
    to {
      opacity: 0.82;
      transform: translate3d(2.5%, -1%, 0) rotate(0.5deg);
    }
  }

  #desk-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.001;
    transition:
      opacity 1.05s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  #desk-root.scene-ready #desk-canvas {
    opacity: 1;
  }

  #desk-canvas.blurred {
    filter: blur(9px) brightness(0.88);
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    #scene-loader,
    #desk-canvas {
      transition-duration: 180ms;
    }

    .scene-loader__drift,
    .scene-loader__atmosphere {
      animation: none;
      transform: none;
    }

    .scene-loader__poster {
      filter: brightness(0.9) saturate(0.95);
    }
  }

  /* —— CSS3D 屏幕系统层：canvas 之上、HUD 之下 —— */
  #screen-os-layer {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    overflow: hidden;
    opacity: 0;
    transition:
      opacity 1.6s ease,
      filter 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  #screen-os-layer.on {
    opacity: 1;
  }

  /* HTML 面板打开时与 canvas 同步虚化，避免屏幕独自清晰 */
  #desk-canvas.blurred ~ #screen-os-layer {
    filter: blur(9px) brightness(0.88);
    transform: scale(1.02);
  }

  /* 入口暗角（校准成功后淡出） */
  #vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 42% 46%,
      transparent 18%,
      rgb(8 5 2 / 0.62) 78%
    );
    transition: opacity 2.5s ease;
  }

  #vignette.fade-out {
    opacity: 0;
  }

  /* —— HUD —— */
  #hud {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
  }

  /* 悬停标签：极简 pill，半透明纸底 + 轻模糊，JS 用 transform 定位 */
  #hotspot-tip {
    position: absolute;
    left: 0;
    top: 0;
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
    padding: 0.4em 0.95em;
    border-radius: 999px;
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    background: var(--paper-raised);
    background: color-mix(in srgb, var(--paper-raised) 60%, transparent);
    -webkit-backdrop-filter: blur(6px) saturate(1.1);
    backdrop-filter: blur(6px) saturate(1.1);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--line) 45%, transparent),
      0 2px 8px rgb(30 20 8 / 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translate3d(-100vw, 0, 0);
    transition:
      transform var(--dur-fast) var(--ease-out),
      opacity 0.16s ease,
      visibility 0s linear 0.16s;
    will-change: transform, opacity;
  }

  #hotspot-tip.show {
    opacity: 1;
    visibility: visible;
    transition:
      transform var(--dur-fast) var(--ease-out),
      opacity 0.18s ease;
  }

  #hotspot-tip :global(strong) {
    color: var(--brass);
    font-weight: 600;
  }

  #hotspot-tip :global(span) {
    color: var(--ink-soft);
  }

  #hotspot-tip :global(span)::before {
    content: '·';
    margin: 0 0.55em;
    color: var(--ink-faint);
  }

  #toast {
    position: absolute;
    top: max(var(--space-5), env(safe-area-inset-top));
    left: 50%;
    translate: -50% 0;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: var(--shadow);
    padding: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    color: var(--ink-soft);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #toast.show {
    opacity: 1;
  }

  #entry-ui {
    position: absolute;
    left: clamp(1.5rem, 4.5vw, 4.75rem);
    bottom: clamp(2rem, 7vh, 4.75rem);
    max-width: 22rem;
    text-align: left;
    transition: opacity 0.6s ease;
  }

  #entry-ui.fade-out {
    opacity: 0;
  }

  #entry-caption {
    font-size: clamp(0.92rem, 1.25vw, 1.12rem);
    color: rgb(233 220 194 / 0.86);
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.6);
    line-height: 1.9;
    letter-spacing: 0.055em;
  }

  #entry-caption :global(strong) {
    color: var(--brass-bright);
  }

  #entry-feedback {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--brass-bright);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.6);
  }

  #mute-btn {
    position: absolute;
    right: max(var(--space-4), env(safe-area-inset-right));
    bottom: max(var(--space-4), env(safe-area-inset-bottom));
    z-index: 12;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    color: var(--brass);
    font-size: var(--text-base);
    box-shadow: var(--shadow);
  }

  #mute-btn.muted {
    color: var(--ink-faint);
    text-decoration: line-through;
  }

  /* —— 覆盖面板 —— */
  #overlay-backdrop {
    position: fixed;
    inset: 0;
    background: var(--scrim);
    z-index: 20;
  }

  #panel {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(46rem, 92vw);
    height: min(86dvh, 56rem);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
    display: flex;
    flex-direction: column;
    z-index: 30;
    outline: none;
  }

  #panel.popover {
    width: min(24rem, 88vw);
    height: auto;
    max-height: 72dvh;
  }

  #panel > header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--line-soft);
    flex-shrink: 0;
  }

  #panel-title {
    font-weight: 700;
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  #panel-close {
    color: var(--ink-faint);
    font-size: var(--text-lg);
    line-height: 1;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
  }

  #panel-close:hover {
    color: var(--brass);
    background: var(--paper-sunken);
  }

  #panel-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 0 var(--space-6) var(--space-6);
  }

  #panel.popover #panel-scroll {
    padding: var(--space-4);
  }

  @media (max-width: 768px) {
    #entry-ui {
      left: max(1.25rem, env(safe-area-inset-left));
      right: max(1.25rem, env(safe-area-inset-right));
      bottom: max(3.25rem, calc(env(safe-area-inset-bottom) + 3rem));
      max-width: none;
      text-align: center;
    }

    #panel {
      width: 100vw;
      height: 100dvh;
      border-radius: 0;
      border: none;
